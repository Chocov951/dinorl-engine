{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.dinorl.dev/v1/rl/progress-v1.schema.json",
  "title": "DinoRL run progress v1",
  "description": "Strict monotonic counters reported by a training run.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "job_id", "status", "budget_units", "completed_units", "learner_transitions", "engine_actions", "epochs", "optimizer_steps"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "run_id": {"$ref": "#/$defs/opaque_id"},
    "job_id": {"$ref": "#/$defs/opaque_id"},
    "status": {"enum": ["queued", "compiling", "running", "evaluating", "completed", "failed", "cancelled"]},
    "budget_units": {"type": "integer", "minimum": 1},
    "completed_units": {"type": "integer", "minimum": 0},
    "learner_transitions": {"type": "integer", "minimum": 0},
    "engine_actions": {"type": "integer", "minimum": 0},
    "epochs": {"type": "integer", "minimum": 0},
    "optimizer_steps": {"type": "integer", "minimum": 0}
  },
  "$defs": {
    "opaque_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"}
  }
}
